{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TutorApp",
  "version": "0.2.1",
  "identifier": "com.tutor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TutorApp",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/TutorApp/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Приложение для репетитора",
    "longDescription": "Календарь занятий, напоминания и планирование для репетиторов",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwOTdGNUQxNkIxNkZENjgKUldSby9SWnIwZldYRUluMm9mdlg5R3poWjZRdk5RUHhTQWkrSkVZa1crOCtPZGp6ZHRkS1ZLQ04K",
      "endpoints": [
        "https://github.com/kostyanpilkin-hash/tutorapp_public/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "basicUi" }
    }
  }
}
